{
  "name": "ode",
  "version": "0.0.1",
  "description": "A lightweight, Vite-native CSF 3 alternative to Storybook. Agent-first component lab.",
  "keywords": [
    "storybook",
    "stories",
    "csf",
    "vite",
    "components",
    "ui",
    "react",
    "solid"
  ],
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "homepage": "https://ode.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millionco/ode.git"
  },
  "bugs": {
    "url": "https://github.com/millionco/ode/issues"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "ode": "./dist/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "default": "./dist/boot.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./test": {
      "default": "./dist/test.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "default": "./dist/mcp.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./shell/*": "./dist/shell/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:shell && vp pack",
    "build:shell": "vite build --config src/shell/vite.config.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:integration": "vp test --project integration",
    "typecheck": "tsc --noEmit",
    "check:errors": "node ./scripts/check-errors.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "mri": "^1.2.0",
    "oxc-parser": "^0.108.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.5.0",
    "typescript": ">=5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pierre/trees": "1.0.0-beta.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "playwright": "^1.60.0",
    "preact": "^10.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "ts-dedent": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
